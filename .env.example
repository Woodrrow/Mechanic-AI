# ---------------------------------------------------------------------------
# Pocket Mechanic — environment
# Copy to .env.local. Every provider is optional: with nothing set, the app
# runs in demo mode against bundled fixtures so the UI can be exercised
# before the government API keys arrive.
# ---------------------------------------------------------------------------

# DVLA Vehicle Enquiry Service (free; register once, key arrives by email)
# https://register-for-ves.driver-vehicle-licensing.api.gov.uk/
DVLA_VES_API_KEY=
# Production by default. With a UAT key use https://uat.driver-vehicle-licensing.api.gov.uk
DVLA_VES_BASE_URL=https://driver-vehicle-licensing.api.gov.uk

# DVSA MOT History API (free; OAuth2 client-credentials + API key)
# https://documentation.history.mot.api.gov.uk/mot-history-api/register
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_API_KEY=
# These two are sent with your credentials; override only if DVSA tells you to.
DVSA_MOT_TOKEN_URL=https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token
DVSA_MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
DVSA_MOT_BASE_URL=https://history.mot.api.gov.uk

# NHTSA vPIC needs no key. Override only for testing.
NHTSA_VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api

# Supabase (optional in Phase 1). Unset = garage lives in this device's localStorage.
# Enable "Anonymous sign-ins" under Authentication > Providers, then run supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force bundled fixtures even when keys are present (1 = on).
POCKET_MECHANIC_USE_FIXTURES=
